package com.aura.core.database.di

import android.content.Context
import androidx.room.Room
import com.aura.core.database.AuraDatabase
import com.aura.core.database.MIGRATION_4_5
import dagger.Module
import dagger.Provides
import dagger.hilt.InstallIn
import dagger.hilt.android.qualifiers.ApplicationContext
import dagger.hilt.components.SingletonComponent
import javax.inject.Singleton

@Module
@InstallIn(SingletonComponent::class)
object DatabaseModule {

    @Provides
    @Singleton
    fun provideDatabase(@ApplicationContext context: Context): AuraDatabase {
        return Room.databaseBuilder(
            context,
            AuraDatabase::class.java,
            "aura_database"
        )
            .addMigrations(MIGRATION_4_5)
            .build()
    }

    @Provides fun provideScanRevisionDao(db: AuraDatabase) = db.scanRevisionDao()
    @Provides fun provideTrackDao(db: AuraDatabase) = db.trackDao()
    @Provides fun provideArtistDao(db: AuraDatabase) = db.artistDao()
    @Provides fun provideAlbumDao(db: AuraDatabase) = db.albumDao()
    @Provides fun provideGenreDao(db: AuraDatabase) = db.genreDao()
    @Provides fun provideTrackUserOverlayDao(db: AuraDatabase) = db.trackUserOverlayDao()
    @Provides fun providePlaybackEventDao(db: AuraDatabase) = db.playbackEventDao()
    @Provides fun provideFolderDao(db: AuraDatabase): FolderDao = db.folderDao()
}
